template <typename T, typename K>
class Tuple {
public:
    Tuple(T a, K b) : a(a), b(b) {}

    T a;
    K b;
};

template <typename T, typename K, typename L>
class Triple {
public:
    Tuple(T a, K b, L c) : a(a), b(b), c(c) {}

    T a;
    K b;
    L c;
};


